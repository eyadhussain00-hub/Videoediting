@@ -103,6 +104,32 @@ def retighten(a, C):
           f"first cut in {old[0][0]:.2f} → {cuts[0]['in']:.2f}; cards " + ", ".join(str(c.get("at_out")) for c in (E.get("ctas") or []) if isinstance(c, dict)))
 
 
+def merge_short(cuts, audio, C):
+    """A shot shorter than min_clip_s next to a ≤ merge_gap_s join reads as a stutter (#2 v7 at 1:25, Eyad 1 Oct) → join it
+    to that neighbour, putting the small pause back — only when the join is silent on the lav (so a word the edit
+    removed there can never come back). Re-ordered cuts (negative gap) are left alone. Punch-ins re-alternate."""
+    x = np.frombuffer(subprocess.run(["ffmpeg", "-v", "error", "-i", str(audio), "-ac", "1", "-ar", "16000", "-f", "f32le", "-"],
+                                     capture_output=True, check=True).stdout, np.float32)
+    lvl = lambda a, b: 10 * np.log10(np.mean(x[int(a * 16000):max(int(b * 16000), int(a * 16000) + 1)] ** 2) + 1e-12)
+    speech = np.percentile([lvl(c["in"], c["out"]) for c in cuts], 50)
+    cuts = [dict(c) for c in cuts]; changed = True
+    while changed:
+        changed = False
+        for i, c in enumerate(cuts):
+            if c["out"] - c["in"] >= C["min_clip_s"]: continue
+            opts = []
+            if i and 0 <= c["in"] - cuts[i - 1]["out"] <= C.get("merge_gap_s", 0.35): opts.append((c["in"] - cuts[i - 1]["out"], i - 1))
+            if i + 1 < len(cuts) and 0 <= cuts[i + 1]["in"] - c["out"] <= C.get("merge_gap_s", 0.35): opts.append((cuts[i + 1]["in"] - c["out"], i))
+            for gap, j in sorted(opts):
+                if lvl(cuts[j]["out"], cuts[j + 1]["in"]) < speech - 18:   # the join is a pause, not a removed word
+                    cuts[j]["out"] = cuts[j + 1]["out"]; del cuts[j + 1]; changed = True; break
+            if changed: break
+    for i, c in enumerate(cuts):
+        c.pop("punch", None)
+        if i % 2: c["punch"] = True
+    return cuts
+
+
 def cut_blocks(audio, words_path, blocks, fps, C):
     x = np.frombuffer(subprocess.run(["ffmpeg", "-v", "error", "-i", str(audio), "-ac", "1", "-ar", str(SR), "-f", "f32le", "-"],
