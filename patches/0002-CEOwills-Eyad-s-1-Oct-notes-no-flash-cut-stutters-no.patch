diff --git a/tools/ceowills/pauses.py b/tools/ceowills/pauses.py
index 8302fd1..8ede022 100755
--- a/tools/ceowills/pauses.py
+++ b/tools/ceowills/pauses.py
@@ -78,6 +78,7 @@ def retighten(a, C):
     # from there instead of cutting the hold short (#2 v7 first render: the CTA was up for 0.9 s)
     if blocks[-1][1] < hold - 0.05: E["mute_after"] = round(blocks[-1][1], 2)
